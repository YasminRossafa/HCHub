rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A student can only read/write their own profile document.
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default (extended later for professor access).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
