rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A student can only read/write their own profile document.
    match /students/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Certificates belong to the owning student only, for now. A professor
      // opens a shareLinks/{token} document (see below) instead of reading
      // this subcollection directly — once that flow is built, add an
      // `allow read` clause here that checks a shareLinks doc whose
      // `studentId` matches `uid`, e.g.:
      //   allow read: if exists(/databases/$(database)/documents/shareLinks/$(request.query... or a passed token))
      //     && get(...).data.studentId == uid;
      // Left as a TODO(professor-access) since the panel isn't built yet.
      match /certificados/{certId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Lets a signed-in student create a share link pointing at themselves.
    // Reading is intentionally denied for everyone (including the owner) —
    // no professor-access flow consumes these yet. TODO(professor-access):
    // once the panel is built, add a scoped `allow get` for an unauthenticated
    // or professor request presenting a valid token, without opening `list`.
    match /shareLinks/{token} {
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
