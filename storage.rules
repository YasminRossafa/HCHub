rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Certificate images: only the owning student can write or read through
    // the SDK. The professor panel never talks to Storage directly — it
    // receives each certificate's `anexoUrl` from the getStudentReportByToken
    // Cloud Function, and that is a getDownloadURL() link, which carries its
    // own bypass token and works without auth. Access control for the
    // professor flow therefore lives in the Cloud Function (it only hands out
    // URLs for the student the share token resolves to), not here.
    match /certificados/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
