rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Certificate images: only the owning student can write, and (for now)
    // only they can read. TODO(professor-access): once the professor panel
    // is built, widen `allow read` to also permit a request presenting a
    // valid shareLinks/{token} for this uid — note that Storage download
    // URLs already carry a bypass token once issued (getDownloadURL()), so
    // the real access control for that flow has to happen before a token is
    // ever handed out, not just here.
    match /certificados/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
